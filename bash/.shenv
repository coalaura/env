# ~/.shenv - shared environment
# by coalaura

function _path_prepend() {
	local dir="$1"

	if [[ ! -d "$dir" ]]; then
		return
	fi

	case ":$PATH:" in
		*":$dir:"*) ;;
		*) PATH="$dir:$PATH" ;;
	esac
}

# safely append to path
function _path_append() {
	local dir="$1"

	if [[ ! -d "$dir" ]]; then
		return
	fi

	case ":$PATH:" in
		*":$dir:"*) ;;
		*) PATH="$PATH:$dir" ;;
	esac
}

_path_prepend "$HOME/.bun/bin"
_path_prepend "/usr/local/zig"
_path_prepend "/usr/local/go/bin"

_path_append "$HOME/go/bin"
_path_append "$HOME/.local/bin"

# go env variables
if command -v go &>/dev/null && command -v zig &>/dev/null; then
    zig="$(command -v zig)"

    cc="$zig cc"
    cxx="$zig c++"

    if [[ "$(go env CC)" != "$cc" || "$(go env CXX)" != "$cxx" ]]; then
        go env -w "CC=$cc" "CXX=$cxx"
    fi
fi

export PATH
