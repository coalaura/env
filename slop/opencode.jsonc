{
	"$schema": "https://opencode.ai/config.json",
	"plugins": [
		// "@tarquinen/opencode-dcp@v3.1.15",
		// "context-mode@1.0.169"
	],
	"permissions": [
		{ "action": "read", "resource": "*", "effect": "allow" },

		{ "action": "read", "resource": "*.env", "effect": "deny" },
		{ "action": "read", "resource": "*.env.*", "effect": "deny" },
		{ "action": "read", "resource": "*.env.example", "effect": "allow" },

		{ "action": "read", "resource": "*/config.yml", "effect": "deny" },
		{ "action": "read", "resource": "*/config.yaml", "effect": "deny" },
		{ "action": "read", "resource": "*/config.toml", "effect": "deny" },

		{ "action": "read", "resource": "~/.ssh/*", "effect": "deny" },

		// Block adding, committing or pushing
		{ "action": "shell", "resource": "git add *", "effect": "deny" },
		{ "action": "shell", "resource": "git commit *", "effect": "deny" },
		{ "action": "shell", "resource": "git push *", "effect": "deny" },

		// Block creating tags but allow listing
		{ "action": "shell", "resource": "git tag *", "effect": "deny" },
		{ "action": "shell", "resource": "git tag", "effect": "allow" },
		{ "action": "shell", "resource": "git tag --list *", "effect": "allow" },
		{ "action": "shell", "resource": "git tag -l *", "effect": "allow" },

		// Block gh tool (no PRs, etc)
		{ "action": "shell", "resource": "gh*", "effect": "deny" },

		// Block ssh
		{ "action": "shell", "resource": "ssh*", "effect": "deny" },
		{ "action": "shell", "resource": "scp*", "effect": "deny" },
		{ "action": "shell", "resource": "rclone*", "effect": "deny" },

		// Preemptively block scetchy things
		{ "action": "shell", "resource": "docker*", "effect": "deny" },
		{ "action": "shell", "resource": "java*", "effect": "deny" },
		{ "action": "shell", "resource": "javaw*", "effect": "deny" },
		{ "action": "shell", "resource": "mkfs*", "effect": "deny" },
		{ "action": "shell", "resource": "fdisk*", "effect": "deny" },
		{ "action": "shell", "resource": "parted*", "effect": "deny" },
		{ "action": "shell", "resource": "mount*", "effect": "deny" },
		{ "action": "shell", "resource": "umount*", "effect": "deny" },
		{ "action": "shell", "resource": "dd *", "effect": "deny" },
		{ "action": "shell", "resource": "systemctl*", "effect": "deny" },
		{ "action": "shell", "resource": "service*", "effect": "deny" },
		{ "action": "shell", "resource": "shutdown*", "effect": "deny" },
		{ "action": "shell", "resource": "reboot*", "effect": "deny" },
		{ "action": "shell", "resource": "schtasks*", "effect": "deny" },
		{ "action": "shell", "resource": "sc.exe*", "effect": "deny" },
		{ "action": "shell", "resource": "reg.exe*", "effect": "deny" },
		{ "action": "shell", "resource": "regedit*", "effect": "deny" },

		// Prevent modifications to Go modules and sources
		{ "action": "edit", "resource": "~/go/**", "effect": "deny" },
		{ "action": "edit", "resource": "C:/Program Files/Go/src/**", "effect": "deny" },
		{ "action": "edit", "resource": "/usr/local/go/src/**", "effect": "deny" },

		{ "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },

		{ "action": "external_directory", "resource": "~/go/**", "effect": "allow" },
		{ "action": "external_directory", "resource": "C:/Program Files/Go/src/**", "effect": "allow" },
		{ "action": "external_directory", "resource": "/usr/local/go/src/**", "effect": "allow" }
	],
	"experimental": {
		"policies": [
			{ "effect": "deny", "action": "provider.use", "resource": "*" },
			{ "effect": "allow", "action": "provider.use", "resource": "llama.cpp" },
			{ "effect": "allow", "action": "provider.use", "resource": "openai" },
			{ "effect": "allow", "action": "provider.use", "resource": "openrouter" }
		]
	},
	"providers": {
		"llama.cpp": {
			"package": "@opencode/ai/providers/openai-compatible",
			"name": "LLama.cpp (local)",
			"settings": {
				"baseURL": "http://localhost:1234/v1"
			},
			"models": {
				"qwen/qwen3.8-27b": {
					"name": "Qwen3.8 27B",
					"limit": {
						"context": 131072,
						"output": 65536
					}
				},
				"qwen/qwen3.8-27b-heretic": {
					"name": "Qwen3.8 27B Heretic",
					"limit": {
						"context": 65536,
						"output": 65536
					}
				}
			}
		},
		"openrouter": {
			"models": {
				// Optimize providers for openweight models
				"deepseek/deepseek-v4.1-flash": {
					"body": {
						"provider": {
							"order": [
								"siliconflow/fp8",
								"novita/fp8",
								"parasail/fp8",
								"fireworks"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3-flash": {
					"body": {
						"provider": {
							"order": [
								"fireworks",
								"z-ai/fp8",
								"siliconflow/fp8"
							],
							"allow_fallbacks": false
						}
					}
				},
				"z-ai/glm-5.3": {
					"body": {
						"provider": {
							"order": [
								"together",
								"parasail/fp8",
								"akashml/fp8",
								"venice"
							],
							"allow_fallbacks": false
						}
					}
				},

				// Avoid retaining providers
				"x-ai/grok-4.6": {
					"body": {
						"provider": {
							"only": [
								"xai/zdr"
							],
							"allow_fallbacks": false
						}
					}
				},
				"google/gemini-3.8-flash": {
					"body": {
						"provider": {
							"only": [
								"google-vertex/global"
							],
							"allow_fallbacks": false
						}
					}
				},

				// OpenAI flex models
				"openai/gpt-5.6-sol-flex": {
					"modelID": "openai/gpt-5.6-sol",
					"name": "GPT-5.6 Sol (Flex)",
					"body": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				},
				"openai/gpt-6-astra-flex": {
					"modelID": "openai/gpt-6-astra",
					"name": "GPT-6 Astra (Flex)",
					"body": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				}
			}
		}
	},
	"agents": {
		// Agent for local models, no parallel agents
		"llama.cpp": {
			"description": "LLama.cpp",
			"color": "#89b4fa",
			"mode": "primary",
			"model": "llama.cpp/qwen/qwen3.8-27b",
			"permissions": [
				{ "action": "subagent", "resource": "*", "effect": "deny" }
			]
		},

		// OpenAI agent, only calls OpenAI subagents
		"openai": {
			"description": "OpenAI",
			"color": "#f9e2af",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"permissions": [
				{ "action": "subagent", "resource": "*", "effect": "deny" },
				{ "action": "subagent", "resource": "openai-*", "effect": "allow" }
			]
		},

		"openai-explore": {
			"mode": "subagent",
			"color": "#fab387",
			"model": "openai/gpt-5.6-terra",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"openai-general": {
			"mode": "subagent",
			"color": "#f9e2af",
			"model": "openai/gpt-5.6-terra",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"openai-quick": {
			"mode": "subagent",
			"color": "#f5e0dc",
			"model": "openai/gpt-5.6-luna",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// OpenRouter agent, only calls OpenRouter subagents
		"openrouter": {
			"description": "OpenRouter",
			"color": "#f38ba8",
			"mode": "primary",
			"model": "openrouter/deepseek/deepseek-v4.1-flash",
			"permissions": [
				{ "action": "subagent", "resource": "*", "effect": "deny" },
				{ "action": "subagent", "resource": "router-*", "effect": "allow" }
			]
		},

		"router-explore": {
			"mode": "subagent",
			"color": "#eba0ac",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"router-general": {
			"mode": "subagent",
			"color": "#f38ba8",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"router-quick": {
			"mode": "subagent",
			"color": "#f2cdcd",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// Built-in agents, color only — all default behavior remains unchanged
		"build": {
			"color": "#a6e3a1"
		},
		"plan": {
			"color": "#cba6f7"
		},
		"general": {
			"color": "#94e2d5"
		},
		"explore": {
			"color": "#fab387"
		}
	},
	"default_agent": "openai",
	"shell": "bash"
}
