{
	"$schema": "https://opencode.ai/config.json",
	"lsp": {
		"gopls": {
			"command": [ "gopls" ],
			"extensions": [ ".go" ]
		},

		// Avoid automatically downloading other LSPs
		// https://raw.githubusercontent.com/anomalyco/opencode/dev/packages/opencode/src/lsp/server.ts
		"deno": { "disabled": true },
		"typescript": { "disabled": true },
		"vue": { "disabled": true },
		"eslint": { "disabled": true },
		"oxlint": { "disabled": true },
		"biome": { "disabled": true },
		"ruby-lsp": { "disabled": true },
		"ty": { "disabled": true },
		"pyright": { "disabled": true },
		"elixir-ls": { "disabled": true },
		"zls": { "disabled": true },
		"csharp": { "disabled": true },
		"razor": { "disabled": true },
		"fsharp": { "disabled": true },
		"sourcekit-lsp": { "disabled": true },
		"rust": { "disabled": true },
		"clangd": { "disabled": true },
		"svelte": { "disabled": true },
		"astro": { "disabled": true },
		"jdtls": { "disabled": true },
		"kotlin-ls": { "disabled": true },
		"yaml-ls": { "disabled": true },
		"lua-ls": { "disabled": true },
		"php intelephense": { "disabled": true },
		"prisma": { "disabled": true },
		"dart": { "disabled": true },
		"ocaml-lsp": { "disabled": true },
		"bash": { "disabled": true },
		"terraform": { "disabled": true },
		"texlab": { "disabled": true },
		"dockerfile": { "disabled": true },
		"gleam": { "disabled": true },
		"clojure-lsp": { "disabled": true },
		"nixd": { "disabled": true },
		"tinymist": { "disabled": true },
		"haskell-language-server": { "disabled": true },
		"julials": { "disabled": true }
	},
	"plugin": [
		"@tarquinen/opencode-dcp@v3.1.15",
		"context-mode@1.0.169"
	],
	"permission": {
		"external_directory": {
			"~/go/**": "allow"
		}
	},
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LM Studio (local)",
			"options": {
				"baseURL": "http://192.168.178.222:1234/v1"
			},
			"models": {
				"qwen/qwen3.8-27b": {
					"name": "Qwen3.8 27B",
					"limit": {
						"context": 163840,
						"output": 65536
					}
				}
			}
		},
		"openai": {
			"whitelist": [
				"gpt-5.6-sol",
				"gpt-5.6-terra",
				"gpt-5.6-luna"
			]
		},
		"openrouter": {
			"whitelist": [
				"openai/gpt-5.6-sol",
				"openai/gpt-5.6-sol-flex",
				"x-ai/grok-4.6",
				"google/gemini-3.7-flash",
				"openai/gpt-5.6-terra",
				"openai/gpt-5.6-luna",
				"moonshotai/kimi-k3",
				"z-ai/glm-5.3",
				"z-ai/glm-5.3-flash",
				"qwen/qwen3.8-max",
				"deepseek/deepseek-v4-pro-0813"
			],
			"models": {
				"openai/gpt-5.6-sol-flex": {
					"id": "openai/gpt-5.6-sol",
					"name": "GPT-5.6 Sol (Flex)",
					"options": {
						"provider": {
							"order": [
								"openai/flex"
							],
							"allow_fallbacks": false
						}
					}
				}
			}
		}
	},
	"agent": {
		// Agent for local models, no parallel agents
		"lmstudio": {
			"description": "LM Studio",
			"color": "#5ca4e4",
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.8-27b",
			"permission": {
				"task": "deny"
			}
		},

		// OpenAI agent, only calls OpenAI subagents
		"openai": {
			"description": "OpenAI",
			"color": "#e89b3f",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"permission": {
				"task": {
					"*": "deny",
					"openai-*": "allow"
				}
			}
		},

		"openai-explore": {
			"mode": "subagent",
			"color": "#e7ac6e",
			"model": "openai/gpt-5.6-terra",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"openai-general": {
			"mode": "subagent",
			"color": "#ebb983",
			"model": "openai/gpt-5.6-terra",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"openai-quick": {
			"mode": "subagent",
			"color": "#efc99f",
			"model": "openai/gpt-5.6-luna",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// OpenRouter agent, only calls OpenRouter subagents
		"openrouter": {
			"description": "OpenRouter",
			"color": "#e85c5c",
			"mode": "primary",
			"model": "openrouter/openai/gpt-5.6-sol-flex",

			"permission": {
				"task": {
					"*": "deny",
					"router-*": "allow"
				}
			}
		},

		"router-explore": {
			"mode": "subagent",
			"color": "#d9777f",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"router-general": {
			"mode": "subagent",
			"color": "#dd888e",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"router-quick": {
			"mode": "subagent",
			"color": "#e29da1",
			"model": "openrouter/z-ai/glm-5.3-flash",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// Built-in agents, color only — all default behavior remains unchanged
		"build": {
			"color": "#8fbd90"
		},
		"plan": {
			"color": "#a58ac7"
		},
		"general": {
			"color": "#75b2aa"
		},
		"explore": {
			"color": "#c4a96d"
		},

		"scout": {
			"disable": true
		}
	},
	"default_agent": "openai",
	"shell": "bash"
}