{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"@tarquinen/opencode-dcp@v3.1.15",
		"context-mode@1.0.169"
	],
	"permission": {
		"external_directory": {
			"~/go/**": "allow"
		}
	},
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LM Studio (local)",
			"options": {
				"baseURL": "http://192.168.178.222:1234/v1"
			},
			"models": {
				"qwen/qwen3.8-27b": {
					"name": "Qwen3.8 27B",
					"limit": {
						"context": 163840,
						"output": 65536
					}
				}
			}
		},
		"openai": {
			"whitelist": [
				"gpt-5.6-sol",
				"gpt-5.6-terra",
				"gpt-5.6-luna"
			]
		},
		"openrouter": {
			"whitelist": [
				"openai/gpt-5.6-sol",
				"x-ai/grok-4.6",
				"google/gemini-3.7-flash",
				"openai/gpt-5.6-terra",
				"openai/gpt-5.6-luna",
				"moonshotai/kimi-k3",
				"z-ai/glm-5.3",
				"qwen/qwen3.8-max",
				"deepseek/deepseek-v4-pro-0813",
				"stealth/ox-alpha"
			]
		}
	},
	"agent": {
		// Agent for local models, no parallel agents
		"lmstudio": {
			"name": "LM Studio",
			"color": "#6fa3d2",
			"mode": "primary",
			"model": "lmstudio/qwen/qwen3.8-27b",
			"permission": {
				"task": "deny"
			}
		},

		// OpenAI agent, only calls OpenAI subagents
		"openai": {
			"name": "OpenAI",
			"color": "#e0a05a",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"permission": {
				"task": {
					"*": "deny",
					"openai-*": "allow"
				}
			}
		},

		"openai-explore": {
			"name": "OpenAI Explore",
			"mode": "subagent",
			"color": "#e7ac6e",
			"model": "openai/gpt-5.6-terra",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"openai-general": {
			"name": "OpenAI General",
			"mode": "subagent",
			"color": "#ebb983",
			"model": "openai/gpt-5.6-terra",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"openai-quick": {
			"name": "OpenAI Quick",
			"mode": "subagent",
			"color": "#efc99f",
			"model": "openai/gpt-5.6-luna",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// OpenRouter agent, only calls OpenRouter subagents
		"openrouter": {
			"name": "OpenRouter",
			"color": "#d66a73",
			"mode": "primary",
			"model": "openrouter/openai/gpt-5.6-sol",

			"permission": {
				"task": {
					"*": "deny",
					"router-*": "allow"
				}
			}
		},

		"router-explore": {
			"name": "OpenRouter Explore",
			"mode": "subagent",
			"color": "#d9777f",
			"model": "openrouter/google/gemini-3.7-flash",
			"description": "Explore and understand the codebase. Use for research, tracing behavior and tasks requiring reliable reasoning."
		},
		"router-general": {
			"name": "OpenRouter General",
			"mode": "subagent",
			"color": "#dd888e",
			"model": "openrouter/z-ai/glm-5.3",
			"description": "Bounded delegated work suited to a capable secondary model: frontend changes, small fixes, routine refactors, research and self-contained implementation tasks. Prefer the primary model for substantial Go/backend, architectural, security-sensitive or high-impact work."
		},
		"router-quick": {
			"name": "OpenRouter Quick",
			"mode": "subagent",
			"color": "#e29da1",
			"model": "openrouter/openai/gpt-5.6-luna",
			"description": "Cheap, fast retrieval and mechanical work. Use for locating files, symbols and references, gathering simple facts and other low-risk tasks that do not need deep reasoning."
		},

		// Built-in agents, color only — all default behavior remains unchanged
		"build": {
			"color": "#8fbd90"
		},
		"plan": {
			"color": "#a58ac7"
		},
		"general": {
			"color": "#75b2aa"
		},
		"explore": {
			"color": "#c4a96d"
		},

		"scout": {
			"disable": true
		}
	},
	"default_agent": "OpenAI",
	"shell": "bash"
}