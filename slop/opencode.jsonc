{
	"$schema": "https://opencode.ai/config.json",
	"plugin": [
		"@tarquinen/opencode-dcp@v3.1.15",
		"context-mode@1.0.169",
		"opencode-lmstudio@0.3.1"
	],
	"permission": {
		"external_directory": {
			"~/go/**": "allow"
		}
	},
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LM Studio (local)",
			"options": {
				"baseURL": "http://127.0.0.1:1234/v1"
			}
		},
		"openai": {
			"whitelist": [
				"gpt-5.6-sol",
				"gpt-5.6-terra",
				"gpt-5.6-luna"
			]
		},
		"openrouter": {
			"whitelist": [
				"openai/gpt-5.6-sol",
				"x-ai/grok-4.6",
				"google/gemini-3.7-flash",
				"openai/gpt-5.6-terra",
				"openai/gpt-5.6-luna",
				"moonshotai/kimi-k3",
				"z-ai/glm-5.3",
				"qwen/qwen3.8-max"
			]
		}
	},
	"agent": {
		"lmstudio": {
			"description": "LM Studio Agent",
			"mode": "primary",
			"permission": {
				"task": "deny"
			}
		}
	},
	"default_agent": "build",
	"shell": "bash"
}