{
	"$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/v3.1.15/dcp.schema.json",
	"enabled": true,
	"pruneNotification": "minimal",
	"pruneNotificationType": "toast",
	"turnProtection": {
		"enabled": true,
		"turns": 2
	},
	"compress": {
		"mode": "range",
		"permission": "allow",
		"showCompression": true,
		"summaryBuffer": true,
		"minContextLimit": 50000,
		"maxContextLimit": 85000,
		"nudgeFrequency": 5,
		"iterationNudgeThreshold": 12,
		"nudgeForce": "soft",
		"protectUserMessages": true
	},
	"strategies": {
		"deduplication": {
			"enabled": true
		},
		"purgeErrors": {
			"enabled": true,
			"turns": 3
		}
	},
	"experimental": {
		"allowSubAgents": false,
		"customPrompts": false
	}
}